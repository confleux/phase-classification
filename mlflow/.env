# MLflow tracking server stack config (overrides docker-compose.yaml defaults).
# Copied to mlflow/.env and adjusted; compose reads these via ${VAR:-default}.

# --- Postgres (artifact metadata / backend store) ---
POSTGRES_DB=mlflow
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow
POSTGRES_PORT=5432

# --- MinIO (S3-compatible artifact store) ---
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniopass
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- MLflow server ---
MLFLOW_PORT=5000
MLFLOW_IMAGE=ghcr.io/mlflow/mlflow:latest

# --- MinIO bucket (created automatically by the createbucket service) ---
MINIO_BUCKET=mlflow
