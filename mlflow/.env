# MLflow tracking server stack config (overrides docker-compose.yml defaults)

# PostgreSQL (backend/metadata store)
POSTGRES_DB=mlflow
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow_password

# MinIO (S3-compatible artifact store)
MINIO_ROOT_USER=mlflowminio
MINIO_ROOT_PASSWORD=minio_password
MINIO_BUCKET=mlflow
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# MLflow server
MLFLOW_PORT=5000
MLFLOW_IMAGE=ghcr.io/mlflow/mlflow:v3.15.1
