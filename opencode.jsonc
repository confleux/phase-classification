{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "mlflow": {
        "type": "local",
        "command": [
          "uv", "run", "--with", "mlflow[mcp]>=3.5.1",
          "mlflow", "mcp", "run"
        ],
        "environment": {
          "MLFLOW_TRACKING_URI": "http://10.10.74.5:5000",
          "MLFLOW_MCP_TOOLS": "ml"
        }
      }
    }
  }
}